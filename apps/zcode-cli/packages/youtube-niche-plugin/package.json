{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/youtube-niche-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "YouTube niche intelligence plugin (stdio MCP server + Niche Explorer panel) for the PaySwap ZCode distribution.",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#niche/*": "./src/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test": "vitest run",
